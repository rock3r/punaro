#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

file_owner() {
	if stat -f '%u' "$1" >/dev/null 2>&1; then stat -f '%u' "$1"; else stat -c '%u' "$1"; fi
}

require_numeric_nonroot() {
	name=$1
	value=$2
	case "$value" in
		''|*[!0-9]*) fail "$name must be a non-zero numeric ID" ;;
	esac
	[ "$value" -gt 0 ] || fail "$name must be a non-zero numeric ID"
}

require_private_file() {
	name=$1
	path=$2
	case "$path" in /*) ;; *) fail "$name must be an absolute path" ;; esac
	[ -f "$path" ] && [ ! -L "$path" ] || fail "$name must be a regular file"
	directory=${path%/*}
	while [ "$directory" != / ]; do
		if [ -L "$directory" ]; then
			[ "$(file_owner "$directory")" = 0 ] || fail "$name must not traverse untrusted symlinked directories"
		else
			if stat -f '%u %Lp %p' "$directory" >/dev/null 2>&1; then set -- $(stat -f '%u %Lp %p' "$directory"); else set -- $(stat -c '%u %a %a' "$directory"); fi
			[ "$1" = 0 ] || [ "$1" = "$(id -u)" ] || fail "$name must use directories owned by root or the current operator"
			case "$2" in *[2367][0-7]|*[0-7][2367]) case "$3" in *1[0-7][0-7][0-7]) ;; *) fail "$name must not traverse group or world writable directories" ;; esac ;; esac
		fi
		directory=${directory%/*}; directory=${directory:-/}
	done
	directory=$(CDPATH= cd -P -- "${path%/*}" && pwd) || fail "$name must use an existing directory"
	while [ "$directory" != / ]; do
		if stat -f '%u %Lp %p' "$directory" >/dev/null 2>&1; then set -- $(stat -f '%u %Lp %p' "$directory"); else set -- $(stat -c '%u %a %a' "$directory"); fi
		[ "$1" = 0 ] || [ "$1" = "$(id -u)" ] || fail "$name must use directories owned by root or the current operator"
		case "$2" in *[2367][0-7]|*[0-7][2367]) case "$3" in *1[0-7][0-7][0-7]) ;; *) fail "$name must not traverse group or world writable directories" ;; esac ;; esac
		directory=${directory%/*}; directory=${directory:-/}
	done
	if stat -f '%u %Lp' "$path" >/dev/null 2>&1; then
		set -- $(stat -f '%u %Lp' "$path")
	else
		set -- $(stat -c '%u %a' "$path")
	fi
	[ "$1" = "$(id -u)" ] || fail "$name must be owned by the current operator"
	case "$2" in *[1-7][0-7]|*[0-7][1-7]) fail "$name must not grant group or world permissions" ;; esac
}

case "${1:-}" in
	down|stop|logs|ps) recovery_command=1 ;;
	*) recovery_command=0 ;;
esac
: "${PUNARO_COMPOSE_PROJECT_NAME:?PUNARO_COMPOSE_PROJECT_NAME is required}"
case "$PUNARO_COMPOSE_PROJECT_NAME" in
	[!a-z0-9]*|*[!a-z0-9_-]*|'') fail 'PUNARO_COMPOSE_PROJECT_NAME must start with a lowercase letter or digit and contain only lowercase letters, digits, underscores, and hyphens' ;;
esac
if [ "$recovery_command" -eq 0 ]; then
	: "${PUNARO_IMAGE:?PUNARO_IMAGE is required}"
	: "${PUNARO_RUNTIME_UID:?PUNARO_RUNTIME_UID is required}"
	: "${PUNARO_RUNTIME_GID:?PUNARO_RUNTIME_GID is required}"
	: "${PUNARO_PUBLIC_URL:?PUNARO_PUBLIC_URL is required}"
	require_numeric_nonroot PUNARO_RUNTIME_UID "$PUNARO_RUNTIME_UID"
	require_numeric_nonroot PUNARO_RUNTIME_GID "$PUNARO_RUNTIME_GID"
case "$PUNARO_PUBLIC_URL" in https://*) ;; *) fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;; esac
case "$PUNARO_PUBLIC_URL" in
	https://|*[[:space:]]*|*'$'*|*'"'*|*"'"*|*'\\'*|*'%'*|https://*[@?#]*) fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;;
esac
public_authority=${PUNARO_PUBLIC_URL#https://}
case "$public_authority" in */) public_authority=${public_authority%/} ;; esac
[ -n "$public_authority" ] || fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL'
case "$public_authority" in */*) fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;; esac
case "$public_authority" in
	\[*\]) ;;
	\[*\]:*) port=${public_authority#*]:}; case "$port" in ''|*[!0-9]*) fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;; esac; [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;;
	*:* ) port=${public_authority##*:}; case "$port" in ''|*[!0-9]*) fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;; esac; [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || fail 'PUNARO_PUBLIC_URL must be a canonical HTTPS public URL' ;;
esac
case "$public_authority" in
	localhost|localhost:*|127.*|[[]::1[]]|[[]::1[]]:*|[[]::[]]|[[]::[]]:*|[[]::[fF][fF][fF][fF]:*[]]|[[]::[fF][fF][fF][fF]:*[]]:*|0.0.0.0|0.0.0.0:*) fail 'PUNARO_PUBLIC_URL must not name a loopback, wildcard, or IPv4-mapped address' ;;
esac

repository=${PUNARO_IMAGE%@sha256:*}
digest=${PUNARO_IMAGE#*@sha256:}
if [ "$repository" = "$PUNARO_IMAGE" ] || [ -z "$repository" ] || [ ${#digest} -ne 64 ]; then
	fail 'PUNARO_IMAGE must be an explicit repository reference pinned by a lowercase sha256 digest'
fi
case "$repository" in
	*[!a-z0-9./:_-]*|*//*|/*|*/|*::*|*:) fail 'PUNARO_IMAGE must be an explicit repository reference pinned by a lowercase sha256 digest' ;;
esac
if ! printf '%s\n' "$repository" | awk '
	{
		pattern = "^((([a-z0-9]([a-z0-9-]*[a-z0-9])?)(\\.([a-z0-9]([a-z0-9-]*[a-z0-9])?))*(\:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*)$"
		exit !($0 ~ pattern)
	}' >/dev/null; then
	fail 'PUNARO_IMAGE must be an explicit repository reference pinned by a lowercase sha256 digest'
fi
case "$digest" in
	*[!0-9a-f]*) fail 'PUNARO_IMAGE must be an explicit repository reference pinned by a lowercase sha256 digest' ;;
esac
fi
case "${1:-}" in
	down|stop|logs|ps) ;;
	*)
		require_private_file PUNARO_POSTGRES_OWNER_PASSWORD_FILE "$PUNARO_POSTGRES_OWNER_PASSWORD_FILE"
		require_private_file PUNARO_POSTGRES_APP_PASSWORD_FILE "$PUNARO_POSTGRES_APP_PASSWORD_FILE"
		require_private_file PUNARO_POSTGRES_APP_DSN_FILE "$PUNARO_POSTGRES_APP_DSN_FILE"
		owner_password=$(cat "$PUNARO_POSTGRES_OWNER_PASSWORD_FILE")
		app_password=$(cat "$PUNARO_POSTGRES_APP_PASSWORD_FILE")
		[ "$(wc -l <"$PUNARO_POSTGRES_OWNER_PASSWORD_FILE")" -eq 0 ] || fail 'PUNARO_POSTGRES_OWNER_PASSWORD_FILE must not contain a newline'
		[ -n "$owner_password" ] || fail 'PUNARO_POSTGRES_OWNER_PASSWORD_FILE must not be empty'
		[ -n "$app_password" ] || fail 'PUNARO_POSTGRES_APP_PASSWORD_FILE must not be empty'
		case "$app_password" in *[!A-Za-z0-9._~-]*) fail 'PUNARO_POSTGRES_APP_PASSWORD_FILE must use URL-safe characters' ;; esac
		app_dsn=$(cat "$PUNARO_POSTGRES_APP_DSN_FILE")
		[ "$app_dsn" = "postgres://punaro_app:$app_password@127.0.0.1:5432/punaro?sslmode=disable" ] || fail 'PUNARO_POSTGRES_APP_DSN_FILE must identify the configured local punaro_app role'
		if [ "$owner_password" = "$app_password" ]; then fail 'PUNARO_POSTGRES_OWNER_PASSWORD_FILE and PUNARO_POSTGRES_APP_PASSWORD_FILE must differ'; fi
		;;
esac

unset COMPOSE_PROFILES COMPOSE_ENV_FILES
export COMPOSE_DISABLE_ENV_FILE=1
exec docker compose --project-name "$PUNARO_COMPOSE_PROJECT_NAME" -f "$root/deploy/compose/production.yaml" "$@"
